# Copy to /etc/immich-polo/immich-polo.env on Archimedes and chmod appropriately.
# Secret values must never be committed.
HOST=127.0.0.1
PORT=13060
DATABASE_PATH=/var/lib/immich-polo/polo.sqlite
POLO_REGISTRATION_SECRET=
POLO_CREDENTIAL_KEY=
SESSION_TTL_DAYS=30
# Enable only after #11-#13 validate the installed Immich v3 runtime.
IMMICH_PROVIDER=unverified
