# Example server block for Archimedes. The local agent must merge this with the
# machine's existing TLS/DNS conventions and verify the selected loopback port.
server {
    listen 80;
    listen [::]:80;
    server_name polo.taylorarchibald.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type text/plain;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name polo.taylorarchibald.com;

    ssl_certificate /etc/letsencrypt/live/polo.taylorarchibald.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/polo.taylorarchibald.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Deployment-generated version metadata; no credentials or user data.
    location = /debug/version {
        alias /var/www/immich-polo/version.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
    }

    # Polo deliberately uses its own bearer authentication. Do not add the
    # Universal SSO auth_request gate used by browser-only webapps.
    location / {
        proxy_pass http://127.0.0.1:13060;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization $http_authorization;

        # Preserve video seeking semantics.
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;

        # Polo streams phone uploads into Immich rather than buffering a second
        # full copy. Keep nginx from defeating that behavior.
        proxy_request_buffering off;
        proxy_buffering off;
        client_max_body_size 8g;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
