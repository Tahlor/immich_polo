[Unit]
Description=Online backup of local Immich Polo metadata
After=immich-polo.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/bin/bash /home/ubuntu/Projects/immich_polo/deploy/archimedes/backup-polo.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/immich-polo /var/backups/immich-polo
