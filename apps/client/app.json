{
  "expo": {
    "name": "Immich Polo",
    "slug": "immich-polo",
    "version": "0.1.0",
    "scheme": "immichpolo",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Immich Polo to choose photos and videos you want to post.",
          "cameraPermission": "Allow Immich Polo to record photos and videos you want to post.",
          "microphonePermission": "Allow Immich Polo to record audio with videos you want to post."
        }
      ]
    ],
    "android": {
      "package": "com.taylorarchibald.immichpolo",
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "com.taylorarchibald.immichpolo"
    },
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
