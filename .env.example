HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/polo.sqlite
# Required to create Polo accounts through POST /auth/register.
POLO_REGISTRATION_SECRET=
# Required before storing real Immich credentials. Generate 32 random bytes and base64-encode them.
POLO_CREDENTIAL_KEY=
SESSION_TTL_DAYS=30
# Keep fail-closed until the target Immich v3 server is validated with issues #11-#13.
# Set to official-v3 on a verified deployment.
IMMICH_PROVIDER=unverified
